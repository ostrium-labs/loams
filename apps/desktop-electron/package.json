{
	"name": "@loams/desktop",
	"version": "0.1.3",
	"private": true,
	"description": "Loams Desktop: the console in an Electron shell with a managed local engine.",
	"license": "Apache-2.0",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "install-electron && node scripts/connectors-catalog.mjs && electron-vite dev",
		"preview": "install-electron && electron-vite preview",
		"catalog": "node scripts/connectors-catalog.mjs",
		"build": "node scripts/connectors-catalog.mjs && electron-vite build",
		"test": "vp test run",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit -p tsconfig.node.json",
		"fetch-engine": "node scripts/fetch-engine.mjs",
		"package": "electron-builder --config electron-builder.config.cjs",
		"loader:generate": "node scripts/generate-loader-gifs.mjs"
	},
	"dependencies": {
		"@noble/ed25519": "3.2.0",
		"ajv": "8.20.0",
		"electron-updater": "6.8.10",
		"js-yaml": "4.3.2",
		"mysql2": "3.24.5",
		"pg": "8.23.1",
		"pg-cursor": "2.22.1"
	},
	"devDependencies": {
		"@bufbuild/protobuf": "2.16.0",
		"@connectrpc/connect": "2.2.0",
		"@connectrpc/connect-web": "2.2.0",
		"@loams/proto": "workspace:*",
		"@playwright/test": "catalog:",
		"@types/node": "24.13.6",
		"@types/pg": "8.23.1",
		"@types/pg-cursor": "2.7.2",
		"cordis": "4.0.0-rc.11",
		"electron": "44.7.0",
		"electron-builder": "26.17.0",
		"electron-vite": "6.0.0",
		"gifenc": "1.0.3",
		"typescript": "5.9.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"yaml": "2.9.1",
		"zod": "catalog:"
	},
	"exports": {
		"./contracts": "./src/shared/contracts.ts",
		"./validate": "./src/shared/validate.ts",
		"./pg-control": "./src/shared/pg-control.ts",
		"./sql-lex": "./src/shared/sql-lex.ts"
	},
	"author": {
		"name": "Loams",
		"email": "hello@loams.dev"
	},
	"homepage": "https://loams.dev",
	"desktopName": "loams-desktop.desktop"
}
