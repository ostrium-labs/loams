{
	"name": "@loams/desktop",
	"version": "0.1.0",
	"private": true,
	"description": "Loams Desktop: the console in an Electron shell with a managed local engine.",
	"license": "Apache-2.0",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit -p tsconfig.node.json",
		"fetch-engine": "node scripts/fetch-engine.mjs",
		"package": "electron-builder --config electron-builder.config.cjs"
	},
	"dependencies": {
		"@noble/ed25519": "3.2.0",
		"electron-updater": "6.8.9",
		"js-yaml": "4.3.2"
	},
	"devDependencies": {
		"@loams-plugins/plugin-forgejo-adapter": "workspace:*",
		"@loams-plugins/plugin-glitchtip-adapter": "workspace:*",
		"@loams-plugins/plugin-itsaplan-adapter": "workspace:*",
		"@loams-plugins/plugin-langfuse-adapter": "workspace:*",
		"@loams-plugins/plugin-matomo-adapter": "workspace:*",
		"@loams-plugins/plugin-openpanel-adapter": "workspace:*",
		"@loams-plugins/plugin-zulip-adapter": "workspace:*",
		"@playwright/test": "1.63.0",
		"@types/node": "24.13.6",
		"cordis": "4.0.0-rc.10",
		"electron": "44.4.5",
		"electron-builder": "26.16.1",
		"electron-vite": "5.0.0",
		"typescript": "5.9.3",
		"vite": "7.3.7",
		"vitest": "5.0.3",
		"zod": "3.25.76"
	},
	"exports": {
		"./contracts": "./src/shared/contracts.ts"
	},
	"author": {
		"name": "Loams",
		"email": "hello@loams.dev"
	},
