{
  "name": "loams-desktop",
  "projectType": "application",
  "sourceRoot": "apps/desktop/native",
  "tags": ["scope:desktop", "type:application", "platform:native"],
  "namedInputs": {
    "desktop": ["{projectRoot}/native/**/*", "!{projectRoot}/native/target/**/*", "{projectRoot}/project.json", {"runtime": "rustc +1.97.1 -vV"}, {"env": "RUSTFLAGS"}, {"env": "CARGO_BUILD_TARGET"}]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["desktop"],
      "outputs": ["{projectRoot}/native/target/debug/loams-desktop", "{projectRoot}/native/target/debug/loams-desktop.exe"],
      "options": {"cwd": "apps/desktop/native", "command": "cargo build --locked --target-dir target -p loams-desktop"}
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["desktop"],
      "outputs": [],
      "options": {"cwd": "apps/desktop/native", "command": "cargo check --locked --target-dir target --workspace --all-targets"}
    },
    "check-minimal": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["desktop"],
      "outputs": [],
      "options": {"cwd": "apps/desktop/native", "command": "cargo check --locked --target-dir target --workspace --all-targets --no-default-features"}
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["desktop"],
      "outputs": [],
      "options": {"cwd": "apps/desktop/native", "command": "cargo test --locked --target-dir target --workspace"}
    },
    "test-core": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["desktop"],
      "outputs": [],
      "options": {"cwd": "apps/desktop/native", "command": "cargo test --locked --target-dir target --workspace --no-default-features --exclude loams-desktop --exclude loams-desktop-ui"}
    },
    "test-focused": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["desktop"],
      "outputs": [],
      "options": {"cwd": "apps/desktop/native", "command": "cargo test --locked --target-dir target --no-default-features -p loams-desktop-brand -p loams-desktop-link -p loams-desktop-proto -p loams-desktop-update -p loams-desktop-theme -p loams-desktop-mcp"}
    },
    "format-check": {
      "executor": "nx:run-commands",
      "inputs": ["desktop"],
      "outputs": [],
      "options": {"cwd": "apps/desktop/native", "command": "cargo fmt --all -- --check"}
    },
    "verify-import": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["desktop", "{projectRoot}/verify_import.py", "{projectRoot}/test_verify_import.py", "{projectRoot}/import-provenance.json"],
      "outputs": [],
      "options": {"cwd": "apps/desktop", "command": "python3 verify_import.py && python3 -m unittest -v test_verify_import"}
    },
    "package-linux": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["desktop"],
      "outputs": ["{projectRoot}/native/target/package"],
      "options": {"cwd": "apps/desktop/native", "command": "bash scripts/package-linux.sh"}
    },
    "package-macos": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["desktop"],
      "outputs": ["{projectRoot}/native/target/package"],
      "options": {"cwd": "apps/desktop/native", "command": "bash scripts/package-macos.sh"}
    },
    "package-windows": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["desktop"],
      "outputs": ["{projectRoot}/native/target/package"],
      "options": {"cwd": "apps/desktop/native", "command": "pwsh -NoProfile -File scripts/package-windows.ps1"}
    }
  }
}
