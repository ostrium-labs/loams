# The Access database of a k3s home (C1): the official postgres image as a
# one-pod StatefulSet in loams-system, with a 10 GiB local-path volume. Rendered
# by lib/loams-k3s-bootstrap when the home uses the local database. It holds no
# secret: the password is in the Secret loams-access-db-auth, which the
# bootstrap writes next to it. The %%NAME%% lines are filled by the bootstrap.
apiVersion: v1
kind: ConfigMap
metadata:
  name: loams-access-db-init
  namespace: loams-system
data:
  init.sql: |
    %%INIT_SQL%%
---
apiVersion: v1
kind: Service
metadata:
  name: loams-access-db
  namespace: loams-system
spec:
  selector:
    app.kubernetes.io/name: loams-access-db
  ports:
    - name: postgres
      port: 5432
      targetPort: postgres
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: loams-access-db
  namespace: loams-system
spec:
  serviceName: loams-access-db
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: loams-access-db
  template:
    metadata:
      labels:
        app.kubernetes.io/name: loams-access-db
    spec:
      securityContext:
        fsGroup: 999
      containers:
        - name: postgres
          image: %%POSTGRES_IMAGE%%
          ports:
            - name: postgres
              containerPort: 5432
          env:
            - name: POSTGRES_USER
              value: loams
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: loams-access-db-auth
                  key: password
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
          readinessProbe:
            exec:
              command: ["pg_isready", "-U", "loams"]
            periodSeconds: 10
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
            - name: init
              mountPath: /docker-entrypoint-initdb.d
              readOnly: true
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
      volumes:
        - name: init
          configMap:
            name: loams-access-db-init
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: local-path
        resources:
          requests:
            storage: 10Gi
