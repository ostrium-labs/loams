# Pins for the k3s home path (OP2-C Task 3). Read by lib/loams-k3s-bootstrap;
# the VM gets this file as /etc/loams-k3s/pins.env. Every value comes from the
# official upstream (D2600), never a fork or a mirror. Bump them together, with
# a new date below, and run tests/byoc/static/run.sh.
#
# Last checked 2026-11-03.

# k3s: the "stable" channel of k3s-io/k3s (channel.yaml on main names
# v1.36.5+k3s1; https://update.k3s.io/v1-release/channels/stable was not
# reachable when this was pinned). The hashes are the k3s and k3s-arm64 lines of
# that release's sha256sum-amd64.txt and sha256sum-arm64.txt:
# https://github.com/k3s-io/k3s/releases/tag/v1.36.5%2Bk3s1
K3S_VERSION=v1.36.5+k3s1
K3S_SHA256_AMD64=d73847bcd3c5fccef0115b372e2f9a91f3032dc84bbf71518a4617565294d313
K3S_SHA256_ARM64=135e34cb9e8a1cfae3cb55577789e93501efe7edc080a8b2630458a85b07721e

# sha256 of install.sh at the same tag:
# https://raw.githubusercontent.com/k3s-io/k3s/v1.36.5%2Bk3s1/install.sh
K3S_INSTALL_SHA256=46177d4c99440b4c0311b67233823a8e8a2fc09693f6c89af1a7161e152fbfad

# Tailscale's package signing key: the primary key fingerprint of
# https://pkgs.tailscale.com/stable/ubuntu/noble.noarmor.gpg (the same file is
# served for the other Ubuntu and Debian releases).
TAILSCALE_KEY_FPR=2596A99EAAB33821893C0A79458CA832957F5868

# The Access database image (C1): the official postgres image, major 17, pinned
# by the digest of its multi-arch index, read from Docker Hub's registry API
# (docker.io/library/postgres:17, Docker-Content-Digest of the OCI index).
POSTGRES_IMAGE=docker.io/library/postgres@sha256:3b0cda93be7c8dba2ed484d19393d93845dc3dafb88973e248ba8e6d99d784e1
