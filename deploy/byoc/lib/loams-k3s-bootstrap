#!/usr/bin/env bash
# First boot of a Loams k3s home (Ubuntu or Debian, amd64 or arm64): joins the
# tailnet, installs k3s from its pinned release, pulls the Loams operator chart
# from GHCR, and writes the manifest that creates the home. Every download is
# checked against a pin or a digest. Safe to run again; a finished run is a no-op.
#
#   loams-k3s-bootstrap               install (the loams-k3s.service unit runs this)
#   loams-k3s-bootstrap --imds-block  (re)apply the rule that keeps pods off the cloud
#                                     metadata service; loams-k3s-imds-block.service
#                                     runs it after k3s.service at every boot
#
# Settings: /etc/loams-k3s/config.env (LOAMS_VERSION is the chart tag; TS_HOSTNAME,
# TAILNET_DOMAIN, DEPLOYMENT, ACCESS_DB=local|external, CHART_DIGEST, and the base64
# values HOME_VALUES_B64, HOME_SECRETS_B64, TARGET_FACTS_B64). Pins: /etc/loams-k3s/pins.env.
# Secrets, read with the VM's own identity (loams-byoc-secrets --get) or, with
# LOAMS_K3S_CLOUD=server, from /etc/loams-k3s/secrets/{tailnet-authkey,k3s-ca.json,access-db.json}:
#   tailnet-authkey   the Tailscale auth key
#   k3s-ca            JSON {server_ca_crt, server_ca_key, client_ca_crt, client_ca_key}
#   access-db         JSON {password} (ACCESS_DB=local) or {dsn} (external)
#
#   LOAMS_K3S_SKIP_SYSTEM=1   for tests, not for a VM: skip the root check, the data disk
#                             and the apt installs; work under LOAMS_K3S_ROOT; and honour
#                             the LOAMS_K3S_{RELEASE,RAW,GHCR}_URL, _ARCH, _SECRETS_BIN
#                             and _ACCESS_DB_TMPL overrides
set -euo pipefail
umask 022

say() { echo "loams-k3s-bootstrap: $*"; }
die() { echo "loams-k3s-bootstrap: $*" >&2; exit 1; }

# k3s's default pod network. Pods must not take the VM's cloud role through the
# metadata service (Review Focus 5), so their traffic to it is dropped in the raw
# table's PREROUTING, the first hook a packet from a pod meets. Nothing in the filter
# table's FORWARD (where kube-router's chains can ACCEPT a pod's traffic ahead of any
# rule of ours) or in k3s's own chains can reorder or bypass it, and it does not depend
# on k3s having started. The unit that runs this is ordered before k3s.service, so there
# is no boot window either. Each rule is checked before it is added: a rerun adds nothing.
pod_cidr="10.42.0.0/16"
imds_block() {
  iptables -w -t raw -N LOAMS-IMDS 2>/dev/null || true
  iptables -w -t raw -C LOAMS-IMDS -s "$pod_cidr" -d 169.254.169.254 -j DROP 2>/dev/null \
    || iptables -w -t raw -A LOAMS-IMDS -s "$pod_cidr" -d 169.254.169.254 -j DROP
  iptables -w -t raw -C PREROUTING -j LOAMS-IMDS 2>/dev/null \
    || iptables -w -t raw -I PREROUTING 1 -j LOAMS-IMDS
}
if [[ "${1:-}" == "--imds-block" ]]; then
  imds_block
  say "pods are blocked from 169.254.169.254"
  exit 0
fi
[[ $# -eq 0 ]] || die "usage: loams-k3s-bootstrap [--imds-block]"

skip_system="${LOAMS_K3S_SKIP_SYSTEM:-0}"
root=""
config="/etc/loams-k3s/config.env"
pins="/etc/loams-k3s/pins.env"
secrets_bin="/usr/local/bin/loams-byoc-secrets"
access_tmpl="/etc/loams-k3s/access-db.yaml.tmpl"
k3s_url="https://github.com/k3s-io/k3s/releases/download"
raw_url="https://raw.githubusercontent.com/k3s-io/k3s"
ghcr_url="https://ghcr.io"
proto='=https'
arch="$(uname -m)"
if [[ "$skip_system" == 1 ]]; then
  root="${LOAMS_K3S_ROOT:?LOAMS_K3S_ROOT is not set}"
  config="${LOAMS_K3S_CONFIG:-$config}"; pins="${LOAMS_K3S_PINS:-$pins}"
  secrets_bin="${LOAMS_K3S_SECRETS_BIN:-$secrets_bin}"; access_tmpl="${LOAMS_K3S_ACCESS_DB_TMPL:-$access_tmpl}"
  k3s_url="${LOAMS_K3S_RELEASE_URL:-$k3s_url}"; raw_url="${LOAMS_K3S_RAW_URL:-$raw_url}"; ghcr_url="${LOAMS_K3S_GHCR_URL:-$ghcr_url}"
  arch="${LOAMS_K3S_ARCH:-$arch}"
  proto='=http,https'
else
  [[ "$(id -u)" -eq 0 ]] || die "run as root"
fi

done_marker="$root/var/lib/loams-k3s/done"
if [[ -f "$done_marker" ]]; then
  say "already done ($done_marker); nothing to do"
  exit 0
fi

# shellcheck disable=SC1090
. "$config"
# shellcheck disable=SC1090
. "$pins"

# --- settings, checked before anything changes -----------------------------------
: "${LOAMS_VERSION:?}" "${TS_HOSTNAME:?}" "${TAILNET_DOMAIN:?}" "${ACCESS_DB:?}" "${HOME_VALUES_B64:?}"
: "${K3S_VERSION:?}" "${K3S_SHA256_AMD64:?}" "${K3S_SHA256_ARM64:?}" "${K3S_INSTALL_SHA256:?}" "${TAILSCALE_KEY_FPR:?}" "${POSTGRES_IMAGE:?}"
cloud="${LOAMS_K3S_CLOUD:-${LOAMS_BYOC_CLOUD:-}}"
deployment="${DEPLOYMENT:-}"
chart_pin="${CHART_DIGEST:-}"
[[ "$LOAMS_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.]+)?$ ]] || die "LOAMS_VERSION must be a release version, not '$LOAMS_VERSION'"
[[ "$TS_HOSTNAME" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || die "TS_HOSTNAME is not a host name: '$TS_HOSTNAME'"
[[ "$TAILNET_DOMAIN" =~ ^[a-z0-9][a-z0-9.-]{0,251}$ ]] || die "TAILNET_DOMAIN is not a domain name: '$TAILNET_DOMAIN'"
[[ "$ACCESS_DB" == local || "$ACCESS_DB" == external ]] || die "ACCESS_DB must be local or external, not '$ACCESS_DB'"
[[ "$chart_pin" =~ ^(sha256:[0-9a-f]{64})?$ ]] || die "CHART_DIGEST must be sha256:<64 hex digits> or empty, not '$chart_pin'"
[[ "$deployment" =~ ^[A-Za-z0-9._-]{0,63}$ ]] || die "DEPLOYMENT is not a name: '$deployment'"
for v in HOME_VALUES_B64 HOME_SECRETS_B64 TARGET_FACTS_B64; do
  [[ "${!v:-}" =~ ^[A-Za-z0-9+/=]*$ ]] || die "$v is not base64"
done
[[ "$K3S_VERSION" =~ ^v[0-9]+\.[0-9]+\.[0-9]+\+k3s[0-9]+$ ]] || die "K3S_VERSION is not a k3s release: '$K3S_VERSION'"
[[ "$K3S_SHA256_AMD64$K3S_SHA256_ARM64$K3S_INSTALL_SHA256" =~ ^[0-9a-f]{192}$ ]] || die "a k3s pin is not a sha256"
[[ "$TAILSCALE_KEY_FPR" =~ ^[0-9A-F]{40}$ ]] || die "TAILSCALE_KEY_FPR is not a fingerprint"
[[ "$POSTGRES_IMAGE" =~ ^[a-z0-9./-]+@sha256:[0-9a-f]{64}$ ]] || die "POSTGRES_IMAGE must be pinned by digest"
case "$cloud" in aws|gcp|azure|server) ;; *) die "the secret store is not known: '$cloud' (aws, gcp, azure or server)" ;; esac
case "$arch" in
  x86_64|amd64) k3s_file=k3s; k3s_sha="$K3S_SHA256_AMD64" ;;
  aarch64|arm64) k3s_file=k3s-arm64; k3s_sha="$K3S_SHA256_ARM64" ;;
  *) die "unsupported architecture $arch (amd64 and arm64 only)" ;;
esac
command -v jq >/dev/null 2>&1 || {
  [[ "$skip_system" != 1 ]] || die "jq is not installed"
  apt-get update -qq; DEBIAN_FRONTEND=noninteractive apt-get install -y -qq jq gnupg curl ca-certificates
}

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# curl for a pinned or digest-checked download: https only (tests: http too),
# and redirects keep to the same rule.
dl() {  # url out [curl args...]
  local url="$1" out="$2"; shift 2
  curl --proto "$proto" --proto-redir "$proto" --tlsv1.2 -fsSL --retry 3 "$@" "$url" -o "$out"
}
sha256_of() { sha256sum "$1" | cut -d' ' -f1; }

# One secret's value on stdout. On a cloud it is read with the VM's identity;
# on a server (server-ssh) from the files the installer left.
secret() {  # name
  if [[ "$cloud" == server ]]; then
    local f="$root/etc/loams-k3s/secrets/$1"
    [[ "$1" == tailnet-authkey ]] || f="$f.json"
    [[ -r "$f" ]] || die "missing secret file $f"
    cat "$f"
  else
    LOAMS_BYOC_CONFIG="$config" "$secrets_bin" --get "$1" "$cloud" || die "could not read the $1 secret"
  fi
}

# --- the secrets and values the home needs, all read and checked first ----------------
authkey="$(secret tailnet-authkey)"
[[ -n "$authkey" ]] || die "the tailnet auth key is empty"
ca_json="$(secret k3s-ca)"
for k in server_ca_crt server_ca_key client_ca_crt client_ca_key; do
  printf '%s' "$ca_json" | jq -e --arg k "$k" '.[$k] | strings | length > 0' >/dev/null || die "the k3s-ca secret has no $k"
done
db_json="$(secret access-db)"
db_password=""; db_dsn=""
if [[ "$ACCESS_DB" == local ]]; then
  db_password="$(printf '%s' "$db_json" | jq -er '.password | strings')" || die "the access-db secret has no password"
  [[ "$db_password" =~ ^[A-Za-z0-9._~-]{16,128}$ ]] || die "the access-db password must be 16 to 128 URL-safe characters (letters, digits, . _ ~ -)"
else
  db_dsn="$(printf '%s' "$db_json" | jq -er '.dsn | strings | select(length > 0)')" || die "the access-db secret has no dsn"
fi

home_values="$(printf '%s' "$HOME_VALUES_B64" | base64 -d | jq -ce 'select(type == "object")')" || die "HOME_VALUES_B64 is not a JSON object"
home_secrets='[]'
[[ -z "${HOME_SECRETS_B64:-}" ]] || home_secrets="$(printf '%s' "$HOME_SECRETS_B64" | base64 -d | jq -ce . 2>/dev/null)" || die "HOME_SECRETS_B64 is not JSON"
printf '%s' "$home_secrets" | jq -e 'type == "array" and all(.[];
    (.name | type == "string" and length <= 253 and test("^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"))
    and (.key | type == "string" and test("^[-._a-zA-Z0-9]{1,253}$"))
    and (.database | type == "string" and test("^[a-z_][a-z0-9_]{0,62}$")))' >/dev/null \
  || die "HOME_SECRETS_B64 must be a list of {name, key, database}: a Secret name, a key, and a plain database name (a-z, 0-9, _)"
facts='{}'
[[ -z "${TARGET_FACTS_B64:-}" ]] || facts="$(printf '%s' "$TARGET_FACTS_B64" | base64 -d | jq -ce . 2>/dev/null)" || die "TARGET_FACTS_B64 is not JSON"
facts="$(printf '%s' "$facts" | jq -ce --arg d "$deployment" 'if type != "object" then error("not an object") else . end
  | with_entries(select(.value != null) | .value |= tostring) | if ($d != "" and (has("deployment") | not)) then . + {deployment: $d} else . end')" \
  || die "TARGET_FACTS_B64 must be a JSON object"
printf '%s' "$facts" | jq -e 'keys | all(test("^[-._a-zA-Z0-9]{1,253}$"))' >/dev/null || die "a fact name in TARGET_FACTS_B64 is not a valid ConfigMap key"

# --- the data disk, if one is attached (k3s keeps everything under /var/lib/rancher) ----
if [[ "$skip_system" != 1 && -n "${DATA_DEVICE:-}" ]]; then
  for _ in $(seq 30); do [[ -b "$DATA_DEVICE" ]] && break; sleep 2; done
  [[ -b "$DATA_DEVICE" ]] || die "data disk $DATA_DEVICE did not appear"
  if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
    say "formatting $DATA_DEVICE as ext4"
    mkfs.ext4 -q -L loams-data "$DATA_DEVICE"
  fi
  mkdir -p /var/lib/rancher
  grep -q ' /var/lib/rancher ' /etc/fstab || echo "LABEL=loams-data /var/lib/rancher ext4 defaults,nofail 0 2" >>/etc/fstab
  mountpoint -q /var/lib/rancher || mount /var/lib/rancher
fi

# --- 1. Tailscale: the vendor's apt repository, key checked by fingerprint -------------
install_tailscale() {
  local id codename keyring=/usr/share/keyrings/tailscale-archive-keyring.gpg got pubs
  export DEBIAN_FRONTEND=noninteractive
  # shellcheck disable=SC1091
  . /etc/os-release
  id="$ID"; codename="${VERSION_CODENAME:-}"
  case "$id" in ubuntu|debian) ;; *) die "Tailscale's apt repository is used on Ubuntu and Debian, not $id" ;; esac
  [[ "$codename" =~ ^[a-z]+$ ]] || die "no release codename in /etc/os-release"
  say "installing Tailscale"
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl gnupg
  curl --proto '=https' --tlsv1.2 -fsSL "https://pkgs.tailscale.com/stable/$id/$codename.noarmor.gpg" -o "$work/tailscale.gpg"
  got="$(gpg --show-keys --with-colons "$work/tailscale.gpg" | awk -F: '$1=="fpr"{print $10; exit}')"
  pubs="$(gpg --show-keys --with-colons "$work/tailscale.gpg" | grep -c '^pub:' || true)"
  [[ "$got" == "$TAILSCALE_KEY_FPR" && "$pubs" == 1 ]] || die "Tailscale's apt key has fingerprint $got ($pubs keys), expected only $TAILSCALE_KEY_FPR"
  install -m 0644 "$work/tailscale.gpg" "$keyring"
  echo "deb [signed-by=$keyring] https://pkgs.tailscale.com/stable/$id $codename main" >/etc/apt/sources.list.d/tailscale.list
  apt-get update -qq
  apt-get install -y -qq tailscale
  systemctl enable --now tailscaled
}
if [[ "$skip_system" != 1 ]] && ! command -v tailscale >/dev/null 2>&1; then install_tailscale; fi
if tailscale ip -4 >/dev/null 2>&1; then
  say "already on the tailnet"
else
  # The key goes in a mode-600 file, not on the command line.
  install -m 600 /dev/null "$work/authkey"
  printf '%s' "$authkey" >"$work/authkey"
  tailscale up --authkey "file:$work/authkey" --hostname "$TS_HOSTNAME"
fi
unset authkey

# --- 2. the cluster CAs, before k3s starts (it generates the other certificates) ----------
tls="$root/var/lib/rancher/k3s/server/tls"
mkdir -p "$tls"
chmod 700 "$root/var/lib/rancher/k3s/server" "$tls"
for pair in server_ca_crt:server-ca.crt:644 server_ca_key:server-ca.key:600 client_ca_crt:client-ca.crt:644 client_ca_key:client-ca.key:600; do
  IFS=: read -r k f mode <<<"$pair"
  install -m "$mode" /dev/null "$tls/$f"
  printf '%s' "$ca_json" | jq -er --arg k "$k" '.[$k]' >"$tls/$f"
done
unset ca_json
# Pod Security: baseline is enforced in every namespace except the two the platform
# itself runs in. It forbids hostNetwork, hostPID and privileged pods, so a pod cannot
# reach the cloud metadata service from the host's network namespace, where the rule
# in step 5 (which matches pod-network sources) does not see it (Review Focus 5). The
# file must exist before k3s first starts; the flag in step 4 points the API server at it.
cat >"$work/psa.yaml" <<'YAML'
apiVersion: apiserver.config.k8s.io/v1
kind: AdmissionConfiguration
plugins:
  - name: PodSecurity
    configuration:
      apiVersion: pod-security.admission.config.k8s.io/v1
      kind: PodSecurityConfiguration
      defaults:
        enforce: baseline
        enforce-version: latest
        audit: restricted
        audit-version: latest
        warn: restricted
        warn-version: latest
      exemptions:
        usernames: []
        runtimeClasses: []
        namespaces: [kube-system, loams-system]
YAML
install -m 0600 "$work/psa.yaml" "$root/var/lib/rancher/k3s/server/psa.yaml"

# --- 3. k3s and its install script, at the pinned tag, checked ---------------------------
etag="${K3S_VERSION//+/%2B}"
dl "$k3s_url/$etag/$k3s_file" "$work/k3s"
[[ "$(sha256_of "$work/k3s")" == "$k3s_sha" ]] || die "$k3s_file for $K3S_VERSION does not match its pinned sha256"
dl "$raw_url/$etag/install.sh" "$work/install.sh"
[[ "$(sha256_of "$work/install.sh")" == "$K3S_INSTALL_SHA256" ]] || die "install.sh for $K3S_VERSION does not match its pinned sha256"
mkdir -p "$root/usr/local/bin"
install -m 0755 "$work/k3s" "$root/usr/local/bin/k3s"

# --- 5. pods stay off the metadata service, before k3s starts: the unit is ordered before
# k3s.service and wanted by it (this amends the brief, which started it after k3s; see Review
# Focus 5: iptables rules do not persist, so a rule added after k3s leaves a window) --------
systemctl daemon-reload
systemctl enable --now loams-k3s-imds-block.service

# --- 4. k3s: no Traefik, secrets encrypted, kubeconfig for root only, Pod Security --------
# The flags are the brief's, plus the Pod Security config file (Review Focus 5, see step 2).
say "installing k3s $K3S_VERSION"
INSTALL_K3S_SKIP_DOWNLOAD=true \
INSTALL_K3S_EXEC="server --disable traefik --secrets-encryption --write-kubeconfig-mode 0600 --tls-san $TS_HOSTNAME --tls-san $TS_HOSTNAME.$TAILNET_DOMAIN --kube-apiserver-arg=admission-control-config-file=/var/lib/rancher/k3s/server/psa.yaml" \
  sh "$work/install.sh"

# --- 6. the operator chart, from GHCR's registry API ---------------------------------------
chart_repo="ostrium-labs/charts/loams-operator"
dl "$ghcr_url/token?service=ghcr.io&scope=repository:$chart_repo:pull" "$work/ghcr-token.json"
printf 'Authorization: Bearer %s\n' "$(jq -er '.token | strings | select(length > 0)' "$work/ghcr-token.json")" >"$work/ghcr.hdr"
dl "$ghcr_url/v2/$chart_repo/manifests/$LOAMS_VERSION" "$work/chart-manifest.json" -H "@$work/ghcr.hdr" \
  -H 'Accept: application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json'
chart_digest="sha256:$(sha256_of "$work/chart-manifest.json")"
if [[ -n "$chart_pin" ]]; then
  [[ "$chart_digest" == "$chart_pin" ]] || die "chart manifest digest $chart_digest does not match the pinned CHART_DIGEST $chart_pin"
  say "chart manifest $chart_digest matches the pin"
else
  say "chart manifest digest $chart_digest (not pinned: CHART_DIGEST is empty; recorded as chart_digest)"
fi
layer="$(jq -er '[.layers[] | select(.mediaType == "application/vnd.cncf.helm.chart.content.v1.tar+gzip") | .digest] | if length == 1 then .[0] else error("not one chart layer") end' "$work/chart-manifest.json")" \
  || die "the chart manifest for $LOAMS_VERSION has no single Helm chart layer"
[[ "$layer" =~ ^sha256:[0-9a-f]{64}$ ]] || die "the chart layer digest is not a sha256: $layer"
dl "$ghcr_url/v2/$chart_repo/blobs/$layer" "$work/chart.tgz" -H "@$work/ghcr.hdr"
[[ "sha256:$(sha256_of "$work/chart.tgz")" == "$layer" ]] || die "chart layer for $LOAMS_VERSION does not match its digest $layer"
charts="$root/var/lib/rancher/k3s/server/static/charts"
mkdir -p "$charts"
install -m 0644 "$work/chart.tgz" "$charts/loams-operator-$LOAMS_VERSION.tgz"

# --- 7. the home: k3s applies everything in its manifests directory --------------------------
# JSON is YAML, so values from outside (DSNs, facts) are written by jq, never spliced into text.
# Passwords and DSNs reach jq through the environment, not its arguments.
manifest="$work/loams-home.yaml"
{
  echo "# Written by loams-k3s-bootstrap for $LOAMS_VERSION: the home. k3s applies it; edit the cluster, not this file."
  cat <<'YAML'
apiVersion: v1
kind: Namespace
metadata:
  name: loams-system
YAML
  printf -- '---\n'
  printf '%s' "$facts" | jq -c --arg d "$chart_digest" '{apiVersion: "v1", kind: "ConfigMap", metadata: {name: "loams-target", namespace: "loams-system"}, data: (. + {chart_digest: $d})}'
  # The Secrets the home names: each key holds the Postgres DSN.
  LK_MODE="$ACCESS_DB" LK_PASSWORD="$db_password" LK_DSN="$db_dsn" \
    jq -nr --argjson entries "$home_secrets" '
      def dsn($e): if env.LK_MODE == "local"
        then "postgres://loams:\(env.LK_PASSWORD)@loams-access-db.loams-system.svc:5432/\($e.database)?sslmode=disable"
        else env.LK_DSN end;
      reduce $entries[] as $e ({}; .[$e.name] += {($e.key): dsn($e)})
      | to_entries[]
      | "---\n" + ({apiVersion: "v1", kind: "Secret", metadata: {name: .key, namespace: "loams-system"}, type: "Opaque", stringData: .value} | tojson)'
  if [[ "$ACCESS_DB" == local ]]; then
    printf -- '---\n'
    LK_PASSWORD="$db_password" jq -nc '{apiVersion: "v1", kind: "Secret", metadata: {name: "loams-access-db-auth", namespace: "loams-system"}, type: "Opaque", stringData: {password: env.LK_PASSWORD}}'
    # The StatefulSet, with an init script that makes the databases the Secrets point
    # at on the first start of an empty volume.
    printf -- '---\n'
    while IFS= read -r line || [[ -n "$line" ]]; do
      case "$line" in
        *%%INIT_SQL%%*)
          lead="${line%%[![:space:]]*}"
          printf '%s' "$home_secrets" | jq -r --arg lead "$lead" '[.[].database] | unique | (map($lead + "CREATE DATABASE " + . + ";") | if length == 0 then [$lead + "SELECT 1;"] else . end)[]'
          ;;
        *) printf '%s\n' "${line//%%POSTGRES_IMAGE%%/$POSTGRES_IMAGE}" ;;
      esac
    done <"$access_tmpl"
  fi
  printf -- '---\n'
  cat <<YAML
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: loams-operator
  namespace: kube-system
spec:
  chart: https://%{KUBERNETES_API}%/static/charts/loams-operator-$LOAMS_VERSION.tgz
  targetNamespace: loams-system
  valuesContent: |
$(printf '%s' "$home_values" | jq . | sed 's/^/    /')
YAML
} >"$manifest"
mdir="$root/var/lib/rancher/k3s/server/manifests"
mkdir -p "$mdir"
# The Secrets are in it: owner only.
install -m 0600 "$manifest" "$mdir/loams-home.yaml"

# --- 8. done ---------------------------------------------------------------------------------
mkdir -p "$root/var/lib/loams-k3s"
touch "$done_marker"
say "done: k3s and the Loams operator are starting; the home is Ready when 'k3s kubectl -n loams-system get loamscluster home' says so"
