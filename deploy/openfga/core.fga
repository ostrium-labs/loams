module core

# Loams' OpenFGA model v1, the core module (design 76 §6, D1603).
#
# The hierarchy is org -> project -> environment -> resource. Roles (owner, admin, editor, viewer,
# deployer) are what gets assigned; application code checks only `can_*` relations, so role
# semantics change here without touching code. Product modules (graph.fga today) hang off
# `environment` and join through fga.mod (schema 1.2).
#
# Principals (D1605): a person is `user:<zitadel_user_id>`, an AI agent `agent:<id>` and any
# other machine `service_account:<id>`, never an email. `environment:<id>` is a Loams namespace
# id (Q1207). Every object path is rooted in one org (D1612).
#
# Agents (D1607): an agent's `owner` confers nothing. It reaches only what it is granted
# directly, and the type restrictions below never let `agent` hold `operator`, `meter_admin`
# or `billing_admin` (D553, D1133). A grant for one agent session uses
# `agent with agent_session` and expires with the session (Q1204).

type user

# One object per install: `platform:default`.
type platform
  relations
    define operator: [user]
    define limits_writer: [user, service_account]
    define meter_admin: [user]
    # Loams Meter (design 63 §19, ME1 Task 10): what application code checks.
    define can_manage_meters: meter_admin
    # Loams Cloud's admins (design 78 §25.8, D1746), on `platform:loams-cloud`.
    # People only: an agent or service account can never hold it, like meter_admin.
    define cloud_admin: [user]

type org
  relations
    define platform: [platform]
    define owner: [user]
    define admin: [user, team#member] or owner
    define member: [user, team#member] or admin
    define billing_admin: [user] or owner
    define billing_viewer: [user, team#member] or billing_admin
    # Loams Meter (design 63 §19, ME1 Task 10): spend controls and alerts need billing_admin;
    # reading an org's usage and entitlements needs billing_viewer, or meter_admin on the platform.
    define can_manage_billing: billing_admin
    define can_view_billing: billing_viewer or meter_admin from platform
    # Who edits the org's own namespaces (`environment#org`): every member, and the service
    # accounts it lists (a project's service accounts, on a single-org install).
    define namespace_editor: [service_account] or member
    # What the admin API (`loams.admin.v1`) checks, one relation per RPC (IA2 Task 5): reads by
    # any member or the org's service accounts, changes by an admin.
    define can_view: namespace_editor
    define can_admin: admin

# Teams are owned by Loams, not Zitadel (§5). `org` roots every team for the cross-org scan.
type team
  relations
    define org: [org]
    define member: [user, team#member]

type agent
  relations
    define owner: [user]
    define project: [project]

type service_account
  relations
    define project: [project]

type project
  relations
    define org: [org]
    define admin: [user, team#member] or admin from org
    define editor: [user, team#member, agent, service_account] or admin
    define viewer: [user, team#member, agent, service_account] or editor
    # The project `admin` role, for destructive actions in a protected environment (§19 §4).
    define can_admin: admin

# A Loams namespace. It is a project's environment (`project`), or, on a single-org install, a
# namespace that is no project's, which belongs to the org itself (`org`, never written beside
# `project`): there every member and listed service account edits, and an org admin deploys
# (IA2 Task 4).
#
# `can_read`, `can_write` and `can_admin` are what data-plane calls scoped to one namespace check
# (collections, KV, Live, Durable namespaces).
type environment
  relations
    define project: [project]
    define org: [org]
    define deployer: [user, team#member, agent, agent with agent_session, service_account] or admin from project or admin from org
    define editor: [user, team#member, agent, agent with agent_session, service_account] or deployer or editor from project or namespace_editor from org
    define viewer: [user, team#member, agent, agent with agent_session, service_account] or editor or viewer from project
    define can_read: viewer
    define can_write: editor
    define can_admin: deployer

# An application deployment (the draft's `deployment`, not CP1's install root).
type deployment
  relations
    define environment: [environment]
    define can_view: viewer from environment
    define can_operate: editor from environment
    define can_destroy: deployer from environment

type database
  relations
    define environment: [environment]
    define can_read: viewer from environment
    define can_write: editor from environment
    define can_admin: deployer from environment
    # Connection details and credentials need editor, not viewer (§46 R1.9, plan IA1 ruling
    # IA2.R3): a viewer reads a database's settings but never gets a credential to it.
    define can_connect: editor from environment

# A managed engine instance (design 81, D1919): RisingWave, Flink SQL or Spark, in one namespace.
# `can_connect` is the gateway's check for the engine's own protocol (Postgres wire, Flink SQL
# Gateway, Spark Connect).
type engine
  relations
    define environment: [environment]
    define can_view: viewer from environment
    define can_operate: editor from environment
    define can_admin: deployer from environment
    # Like `database` (§46 R1.9): a viewer sees an engine but never gets a credential to it.
    define can_connect: editor from environment

# The tuple stores `allowed_session` and `expires`; the request supplies `session_id` and `now`.
condition agent_session(session_id: string, allowed_session: string, now: timestamp, expires: timestamp) {
  session_id == allowed_session && now < expires
}
