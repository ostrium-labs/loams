# syntax=docker/dockerfile:1.7
# Sail, LakeSail's Spark Connect server (Apache-2.0), for managed Spark
# (design 81 R15, SP-a D1990): ghcr.io/ostrium-labs/loams-sail:<sail version>.
# Sail publishes no image; this installs the pinned pysail wheel (which
# carries the `sail` binary) and the PySpark client Sail's Python UDFs use.
# Every pin is at least 14 days old (2026-10-27): pysail 0.7.2 (2026-09-29),
# pyspark-client 4.1.3 (2026-07-15), python 3.13.15-slim-bookworm (2026-09-19).
ARG PYTHON_IMAGE=docker.io/library/python:3.13.15-slim-bookworm@sha256:2325bb286ec344af3e5898cc224b5844e2707ac6e26b1632516fd3edc84a5e26
FROM ${PYTHON_IMAGE}
ARG PYSAIL_VERSION=0.7.2
ARG PYSPARK_VERSION=4.1.3
RUN python3 -m pip install --no-cache-dir \
      "pysail==${PYSAIL_VERSION}" "pyspark-client==${PYSPARK_VERSION}" \
 && groupadd --system --gid 185 sail \
 && useradd --system --uid 185 --gid 185 --create-home sail
USER 185:185
WORKDIR /home/sail
ENV RUST_LOG=info
EXPOSE 50051
LABEL org.opencontainers.image.title="loams-sail" \
      org.opencontainers.image.description="Sail Spark Connect server for Loams managed Spark (preview)" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.loams.licence="Apache-2.0"
ENTRYPOINT ["sail"]
CMD ["spark", "server", "--ip", "0.0.0.0", "--port", "50051"]
