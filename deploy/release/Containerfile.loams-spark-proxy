# syntax=docker/dockerfile:1.7
# The Loams Spark Connect proxy (ghcr.io/ostrium-labs/loams-spark-proxy;
# design 81 R8, SP-a D1992). Built by build.sh from the repository root.
# The same proxy runs as `loams-gateway --module spark` when the gateway is
# built with `--features spark`.
ARG RUST_IMAGE=docker.io/library/rust:1.97.1-slim-trixie
ARG RUNTIME_IMAGE=docker.io/library/debian:trixie-slim

FROM ${RUST_IMAGE} AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      protobuf-compiler libprotobuf-dev pkg-config clang g++ make cmake perl \
 && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_TOOLCHAIN=1.97.1 \
    CARGO_TERM_COLOR=never
WORKDIR /src
COPY . .
ARG CARGO_BUILD_JOBS=
RUN --mount=type=cache,id=loams-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=loams-target-spark-proxy,target=/src/target \
    if [ -n "$CARGO_BUILD_JOBS" ]; then export CARGO_BUILD_JOBS; else unset CARGO_BUILD_JOBS; fi \
 && cargo build --locked --release -p loams-spark --bin loams-spark-proxy \
 && install -D -m 0755 target/release/loams-spark-proxy /out/loams-spark-proxy

FROM ${RUNTIME_IMAGE}
ARG VERSION=dev
ARG REVISION=unknown
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 loams \
 && useradd --system --uid 10001 --gid loams --no-create-home --shell /usr/sbin/nologin loams
COPY --from=build /out/loams-spark-proxy /usr/local/bin/loams-spark-proxy
LABEL org.opencontainers.image.title="loams-spark-proxy" \
      org.opencontainers.image.description="Loams Spark Connect proxy (preview)" \
      org.opencontainers.image.source="https://github.com/ostrium-labs/loams" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="Apache-2.0"
ENV LOAMS_SPARK_PROXY_CONFIG=/etc/loams-spark-proxy/proxy.toml
USER 10001:10001
EXPOSE 15002
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/loams-spark-proxy"]
CMD ["serve"]
