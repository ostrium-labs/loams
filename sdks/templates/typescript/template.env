# The generation manifest for the TypeScript SDK (`@loams/client`), which SDK2
# Task 0 delivered. It is here so `scripts/sdk/drift.sh` and
# `scripts/sdk/check-pins.sh` treat every language the same way rather than
# special-casing the one that arrived first.
#
# Fields:
#   LANG              the value of the facade plugin's `lang=` parameter
#   FACADE_TEMPLATE   buf template that runs protoc-gen-loams-facade
#   STUBS_TEMPLATE    buf template that runs the stub plugins ("" when there is
#                     none, which is Rust's case: D128 generates the stubs in the
#                     SDK crate's own build.rs with connectrpc-build)
#   FACADE_OUT        the generated facade, relative to the repository root;
#                     always compared, because it is one small file per language
#                     and it is the contract every SDK is generated from
#   STUBS_OUT         the generated stubs' root, relative to the repository root
#   STUBS_COMMITTED   "yes" when the language also checks its generated stubs in
#                     (Go: the mirror repository builds from a tag), "no" when
#                     the package builds them at release time (§44 §10.1 point 3)
#   ORDER             the order the templates run in, because one `out` directory
#                     may be an ancestor of the other and buf's `clean: true`
#                     empties it
LANG=typescript
FACADE_TEMPLATE=sdks/typescript/buf.gen.yaml
# One of two stub templates: `buf.gen.apps.yaml` writes @loams/proto in web/ and
# `buf.gen.live.yaml` writes @loams/live, and both are checked in and diffed.
STUBS_TEMPLATE=sdks/typescript/buf.gen.live.yaml
EXTRA_TEMPLATES=buf.gen.apps.yaml
FACADE_OUT=sdks/typescript/packages/client/src/gen/facade.ts
STUBS_OUT=sdks/typescript/packages/live/src/gen
STUBS_COMMITTED=yes
ORDER=facade,stubs
