# The generation manifest for the Python SDK (`loams` on PyPI).
#
# design §44 §10.2 puts the per-language templates in `sdks/templates/<lang>/`,
# and this is that directory's content: one small, machine-readable statement of
# what runs, where its output lands, whether that output is committed, and which
# pins it must agree with. `scripts/sdk/drift.sh` reads it to know what to
# regenerate and what to diff; `scripts/sdk/check-pins.sh` reads the pins it must
# agree with. Neither script hard-codes a language.
#
# Adding a language is therefore two files: this manifest and the buf templates
# it names. The renderer for the language is in `crates/loams-facade-gen`.
#
# Fields:
#   LANG              the value of the facade plugin's `lang=` parameter
#   FACADE_TEMPLATE   buf template that runs protoc-gen-loams-facade
#   STUBS_TEMPLATE    buf template that runs the stub plugins ("" when there is
#                     none, which is Rust's case: D128 generates the stubs in the
#                     SDK crate's own build.rs with connectrpc-build)
#   FACADE_OUT        the generated facade, relative to the repository root;
#                     always compared, because it is one small file per language
#                     and it is the contract every SDK is generated from
#   STUBS_OUT         the generated stubs' root, relative to the repository root
#   STUBS_COMMITTED   "yes" when the language also checks its generated stubs in
#                     (Go: the mirror repository builds from a tag), "no" when
#                     the package builds them at release time (§44 §10.1 point 3)
#   ORDER             the order the templates run in, because one `out` directory
#                     may be an ancestor of the other and buf's `clean: true`
#                     empties it
LANG=python
FACADE_TEMPLATE=sdks/python/buf.gen.yaml
STUBS_TEMPLATE=sdks/python/buf.gen.proto.yaml
FACADE_OUT=sdks/python/src/loams/_gen/facade.py
STUBS_OUT=sdks/python/src
# Not committed: PyPI builds the stubs into the package (§44 §10.1 point 3), so
# there is nothing checked in to drift; only the facade is compared.
STUBS_COMMITTED=no
# The stub template cleans sdks/python/src, which contains the facade's own
# directory, so the stubs run first and the facade is regenerated after them.
ORDER=stubs,facade
