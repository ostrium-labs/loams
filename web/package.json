{
  "name": "loams-web",
  "private": true,
  "description": "The Loams console and the @loams/ui design system (design §19).",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "pnpm --filter @loams/console dev",
    "build": "pnpm --filter @loams/ui build && pnpm --filter @loams/console build",
    "typecheck": "pnpm -r typecheck",
    "lint": "vp check",
    "format": "vp fmt",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
