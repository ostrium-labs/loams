{
  "name": "@loams/plugin-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "The Seed Exchange, the Loams marketplace, in the console and in Studio (design §73 §7.1–§7.2, plan MK1 Task 9): browse with filters, listings in plain words, the consent screen made from agentd's PlanInstall, installed listings with updates and revocation banners, and sources. Experimental.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "loams": {
    "plugin": {
      "kind": "console",
      "entry": ".",
      "tier": "first-party",
      "modes": [
        "console",
        "studio"
      ],
      "inject": [
        "router",
        "slots",
        "agentd"
      ],
      "provides": [],
      "slots": [
        "console.page",
        "shell.nav.section"
      ],
      "permissions": [
        "agentd:use"
      ],
      "requires": {
        "console": "^0.1.0",
        "api": []
      },
      "editions": [
        "oss",
        "desktop",
        "cloud"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vp test run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-query": "catalog:",
    "@loams/agentd-client": "workspace:*",
    "@loams/console-host": "workspace:*",
    "@loams/cordis": "workspace:*",
    "@loams/proto": "workspace:*",
    "@loams/slots": "workspace:*",
    "@loams/ui": "workspace:*",
    "@tanstack/react-query": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}
