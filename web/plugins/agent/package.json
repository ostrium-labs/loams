{
  "name": "@loams/plugin-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Loams Desktop: the agent chat panel in the right dock, and the Agent providers settings section.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "loams": {
    "plugin": {
      "kind": "console",
      "entry": ".",
      "tier": "first-party",
      "inject": [
        "desktop",
        "router",
        "session",
        "slots"
      ],
      "provides": [],
      "slots": [
        "shell.inspector.tab",
        "console.settings.section"
      ],
      "permissions": [],
      "requires": {
        "console": "^0.1.0"
      },
      "editions": [
        "desktop"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vp test run"
  },
  "dependencies": {
    "@loams/console-host": "workspace:*",
    "@loams/cordis": "workspace:*",
    "@loams/slots": "workspace:*",
    "@loams/ui": "workspace:*",
    "dompurify": "3.4.17",
    "lucide-react": "catalog:",
    "marked": "18.1.1"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "30.1.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@loams/desktop": "workspace:*",
    "@loams/platform-electron": "workspace:*",
    "vite-plus": "catalog:"
  }
}
