{
  "name": "@loams/plugin-desktop-settings",
  "version": "0.1.0",
  "private": true,
  "description": "Loams Desktop: the Settings area with its sub-navigation, and the local stacks, updates and about sections.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "loams": {
    "plugin": {
      "kind": "console",
      "entry": ".",
      "tier": "first-party",
      "inject": [
        "desktop",
        "router",
        "slots"
      ],
      "provides": [],
      "slots": [
        "console.page",
        "shell.nav.section",
        "shell.overlay",
        "console.settings.section"
      ],
      "permissions": [],
      "requires": {
        "console": "^0.1.0",
        "api": []
      },
      "editions": [
        "desktop"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vp test run"
  },
  "dependencies": {
    "@loams/console-host": "workspace:*",
    "@loams/desktop": "workspace:*",
    "@loams/cordis": "workspace:*",
    "@loams/slots": "workspace:*",
    "@loams/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@loams/platform-electron": "workspace:*",
    "vite-plus": "catalog:"
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^default",
          "testRuntime",
          "notice"
        ]
      }
    }
  }
}
