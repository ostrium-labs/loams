{
  "name": "@loams/plugin-house",
  "version": "0.1.0",
  "private": true,
  "description": "The Analytics (House) page: ClickHouse-dialect SQL editor, streaming results grid, query history and allowed settings over loams.house.v1.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "loams": {
    "plugin": {
      "kind": "console",
      "entry": ".",
      "tier": "first-party",
      "inject": [
        "router",
        "slots",
        "transport",
        "platform"
      ],
      "provides": [],
      "slots": [
        "console.page",
        "shell.nav.section"
      ],
      "permissions": [],
      "requires": {
        "console": "^0.1.0"
      },
      "editions": [
        "oss",
        "desktop",
        "cloud"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vp test run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@loams/console-host": "workspace:*",
    "@loams/cordis": "workspace:*",
    "@loams/desktop-ui": "workspace:*",
    "@loams/proto": "workspace:*",
    "@loams/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "30.1.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}
