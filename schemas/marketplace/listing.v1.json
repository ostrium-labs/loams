{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loams.dev/schemas/listing/v1.json",
  "title": "Loams Marketplace listing, v1",
  "description": "One version of one listing in a Loams Marketplace index (design 73 section 3.6, D1455). Framework-neutral: an agent in any framework or language, a harness, or an MCP server. Its protobuf form is loams.marketplace.v1.Listing (proto/loams/marketplace/v1/listing.proto); a test keeps the two equal. Each object schema names its message in x-proto-message, and each enum names its proto enum in x-proto-enum.",
  "type": "object",
  "x-proto-message": "Listing",
  "additionalProperties": false,
  "required": ["id", "kind", "version", "title", "summary", "licence", "source", "publisher", "pricing"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "description": "<namespace>/<name>. The namespace is a GitHub organisation or user, or a verified domain; `ostrium` and `loams` are reserved for first-party listings.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,38}/[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "kind": { "$ref": "#/$defs/kind" },
    "version": { "$ref": "#/$defs/semver" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 20000 },
    "icon": {
      "description": "An https URL or a path relative to the listing directory.",
      "type": "string",
      "pattern": "^(https://\\S+|[A-Za-z0-9._/-]+\\.(png|svg|webp))$"
    },
    "licence": {
      "description": "An SPDX licence expression, such as Apache-2.0 or MIT OR Apache-2.0.",
      "type": "string",
      "pattern": "^[A-Za-z0-9.+-]+( (AND|OR|WITH) [A-Za-z0-9.+-]+)*$"
    },
    "source": { "$ref": "#/$defs/source" },
    "publisher": { "$ref": "#/$defs/publisher" },
    "support": { "$ref": "#/$defs/https_url" },
    "security_contact": {
      "description": "An email address or an https URL.",
      "type": "string",
      "pattern": "^([^@\\s]+@[^@\\s]+\\.[^@\\s]+|https://\\S+)$"
    },
    "framework": { "$ref": "#/$defs/framework" },
    "language": { "$ref": "#/$defs/language" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "entrypoint": {
      "description": "A module (node), a module or console script (python), a command (binary) or the image entrypoint (oci).",
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/target" }
    },
    "surfaces": { "$ref": "#/$defs/surfaces" },
    "loams": { "$ref": "#/$defs/loams_capabilities" },
    "connectors": {
      "description": "Connector registry ids (design 33) the agent needs.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "mcp_servers": {
      "type": "array",
      "items": { "$ref": "#/$defs/mcp_server_dependency" }
    },
    "tools": {
      "description": "Every tool the package may call. Undeclared tools are refused at run time (design 73 section 7.4).",
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    },
    "place": { "$ref": "#/$defs/place_template" },
    "models": { "$ref": "#/$defs/models" },
    "cost": { "$ref": "#/$defs/cost_profile" },
    "config": {
      "type": "array",
      "items": { "$ref": "#/$defs/config_input" }
    },
    "conformance": { "$ref": "#/$defs/conformance" },
    "harness": { "$ref": "#/$defs/harness" },
    "mcp_server": { "$ref": "#/$defs/mcp_server" },
    "pricing": {
      "description": "v1 accepts only free listings (design 73 section 11, D1474).",
      "type": "string",
      "x-proto-enum": "Pricing",
      "enum": ["free"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "agent" } }, "required": ["kind"] },
      "then": {
        "required": ["framework", "language", "artifact", "runtime", "entrypoint", "targets", "surfaces", "tools", "models"],
        "properties": {
          "surfaces": {
            "description": "An agent serves ACP or A2A, or both (D1451). A package that serves only MCP is an MCP server.",
            "anyOf": [{ "required": ["acp"] }, { "required": ["a2a"] }]
          }
        },
        "not": { "anyOf": [{ "required": ["harness"] }, { "required": ["mcp_server"] }] }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "harness" } }, "required": ["kind"] },
      "then": {
        "required": ["harness"],
        "not": { "anyOf": [{ "required": ["mcp_server"] }, { "required": ["surfaces"] }] }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "mcp-server" } }, "required": ["kind"] },
      "then": {
        "required": ["mcp_server", "tools"],
        "not": { "anyOf": [{ "required": ["harness"] }, { "required": ["surfaces"] }] }
      }
    },
    {
      "description": "An ACP harness is installed from an artifact; a native one needs adapter code in agentd, so it is first-party only and has none (D1464).",
      "if": {
        "properties": { "harness": { "properties": { "launch": { "properties": { "protocol": { "const": "acp" } } } } } },
        "required": ["harness"]
      },
      "then": { "required": ["artifact", "runtime", "entrypoint"] }
    },
    {
      "if": {
        "properties": { "harness": { "properties": { "launch": { "properties": { "protocol": { "const": "native" } } } } } },
        "required": ["harness"]
      },
      "then": {
        "properties": { "id": { "pattern": "^(ostrium|loams)/" } },
        "not": { "required": ["artifact"] }
      }
    },
    {
      "description": "A local MCP server is installed from an artifact; a remote one is reached at its URL and installs nothing.",
      "if": {
        "properties": { "mcp_server": { "properties": { "mode": { "const": "local" } } } },
        "required": ["mcp_server"]
      },
      "then": { "required": ["artifact", "runtime", "entrypoint"] }
    },
    {
      "if": {
        "properties": { "mcp_server": { "properties": { "mode": { "const": "remote" } } } },
        "required": ["mcp_server"]
      },
      "then": { "not": { "anyOf": [{ "required": ["artifact"] }, { "required": ["runtime"] }] } }
    },
    {
      "description": "Each runtime takes its own artifact type: node npm, python pypi, oci oci, binary archive.",
      "if": { "required": ["runtime", "artifact"] },
      "then": {
        "anyOf": [
          { "properties": { "runtime": { "properties": { "kind": { "const": "node" } } }, "artifact": { "properties": { "type": { "const": "npm" } } } } },
          { "properties": { "runtime": { "properties": { "kind": { "const": "python" } } }, "artifact": { "properties": { "type": { "const": "pypi" } } } } },
          { "properties": { "runtime": { "properties": { "kind": { "const": "oci" } } }, "artifact": { "properties": { "type": { "const": "oci" } } } } },
          { "properties": { "runtime": { "properties": { "kind": { "const": "binary" } } }, "artifact": { "properties": { "type": { "const": "archive" } } } } }
        ]
      }
    },
    {
      "description": "An artifact is installed only with its provenance (D1459).",
      "if": { "required": ["artifact"] },
      "then": { "required": ["provenance"] }
    },
    {
      "if": { "required": ["runtime"] },
      "else": { "not": { "anyOf": [{ "required": ["artifact"] }, { "required": ["entrypoint"] }] } }
    }
  ],
  "$defs": {
    "kind": {
      "type": "string",
      "x-proto-enum": "Kind",
      "enum": ["agent", "harness", "mcp-server"]
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "https_url": { "type": "string", "pattern": "^https://\\S+$" },
    "host": {
      "description": "A host name, optionally with a leading *. for its subdomains.",
      "type": "string",
      "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "source": {
      "type": "object",
      "x-proto-message": "Source",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "$ref": "#/$defs/https_url" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "description": "The package's directory inside the repository.", "type": "string" }
      }
    },
    "publisher": {
      "type": "object",
      "x-proto-message": "Publisher",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "url": { "$ref": "#/$defs/https_url" }
      }
    },
    "framework": {
      "type": "object",
      "x-proto-message": "Framework",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "x-proto-enum": "FrameworkName",
          "enum": ["mastra", "pydantic-ai", "langgraph", "crewai", "openai-agents", "google-adk", "microsoft-agent-framework", "eve", "other"]
        },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "language": {
      "type": "string",
      "x-proto-enum": "Language",
      "enum": ["typescript", "javascript", "python", "go", "rust", "java", "kotlin", "csharp", "zig", "other"]
    },
    "artifact": {
      "type": "object",
      "x-proto-message": "Artifact",
      "additionalProperties": false,
      "required": ["type", "name", "version"],
      "properties": {
        "type": { "type": "string", "x-proto-enum": "ArtifactType", "enum": ["npm", "pypi", "oci", "archive"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "integrity": { "type": "string" },
        "files": {
          "description": "An archive's files, one per platform.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/archive_file" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "npm" } } },
          "then": {
            "required": ["integrity"],
            "properties": { "integrity": { "pattern": "^sha512-[A-Za-z0-9+/]{86}==$" } },
            "not": { "required": ["files"] }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["pypi", "oci"] } } },
          "then": {
            "required": ["integrity"],
            "properties": { "integrity": { "pattern": "^sha256:[0-9a-f]{64}$" } },
            "not": { "required": ["files"] }
          }
        },
        {
          "if": { "properties": { "type": { "const": "archive" } } },
          "then": { "required": ["files"], "not": { "required": ["integrity"] } }
        }
      ]
    },
    "archive_file": {
      "type": "object",
      "x-proto-message": "ArchiveFile",
      "additionalProperties": false,
      "required": ["platform", "url", "sha256"],
      "properties": {
        "platform": {
          "type": "string",
          "x-proto-enum": "Platform",
          "enum": ["linux-x86_64", "linux-aarch64", "darwin-x86_64", "darwin-aarch64", "windows-x86_64", "windows-aarch64"]
        },
        "url": { "$ref": "#/$defs/https_url" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "path": { "description": "The executable's path inside the archive.", "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "x-proto-message": "Provenance",
      "additionalProperties": false,
      "required": ["type", "ref"],
      "properties": {
        "type": {
          "type": "string",
          "x-proto-enum": "ProvenanceType",
          "enum": ["npm-slsa", "pypi-pep740", "cosign", "sigstore-bundle", "github-attestation"]
        },
        "ref": { "description": "Where the attestation or bundle is read from: the npm attestations URL, a bundle URL, or for github-attestation the repository's attestations API (https://api.github.com/repos/<owner>/<repo>/attestations), looked up by each file's SHA-256.", "$ref": "#/$defs/https_url" }
      }
    },
    "runtime": {
      "type": "object",
      "x-proto-message": "Runtime",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "x-proto-enum": "RuntimeKind", "enum": ["node", "python", "oci", "binary"] },
        "version": { "description": "A version range, such as >=22.13.", "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "string",
      "x-proto-enum": "Target",
      "enum": ["agentd", "byoc-server", "app-byoc"]
    },
    "surfaces": {
      "type": "object",
      "x-proto-message": "Surfaces",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "acp": { "$ref": "#/$defs/acp_surface" },
        "a2a": { "$ref": "#/$defs/a2a_surface" },
        "mcp": { "$ref": "#/$defs/mcp_surface" },
        "responses": { "$ref": "#/$defs/responses_surface" }
      }
    },
    "acp_surface": {
      "type": "object",
      "x-proto-message": "AcpSurface",
      "additionalProperties": false,
      "properties": {
        "protocol_version": { "type": "integer", "minimum": 1 }
      }
    },
    "a2a_surface": {
      "type": "object",
      "x-proto-message": "A2aSurface",
      "additionalProperties": false,
      "required": ["agent_card"],
      "properties": {
        "agent_card": {
          "description": "The A2A Agent Card, embedded unchanged.",
          "type": "object",
          "required": ["name"]
        }
      }
    },
    "mcp_surface": {
      "type": "object",
      "x-proto-message": "McpSurface",
      "additionalProperties": false,
      "properties": {
        "transport": { "type": "string", "x-proto-enum": "McpTransport", "enum": ["stdio", "streamable-http"] }
      }
    },
    "responses_surface": {
      "type": "object",
      "x-proto-message": "ResponsesSurface",
      "additionalProperties": false,
      "properties": {}
    },
    "loams_capabilities": {
      "description": "The Loams surfaces the package uses. Each one that is true adds its part of the environment contract (design 73 section 3.3).",
      "type": "object",
      "x-proto-message": "LoamsCapabilities",
      "additionalProperties": false,
      "properties": {
        "postgres": { "type": "boolean" },
        "collections": { "type": "boolean" },
        "qdrant": { "type": "boolean" },
        "elasticsearch": { "type": "boolean" },
        "streams": { "type": "boolean" },
        "live": { "type": "boolean" },
        "durable": { "type": "boolean" },
        "memory": { "type": "boolean" },
        "house": { "type": "boolean" }
      }
    },
    "mcp_server_dependency": {
      "type": "object",
      "x-proto-message": "McpServerDependency",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,38}/[a-z0-9][a-z0-9._-]{0,63}$" },
        "version": { "description": "A version range.", "type": "string", "minLength": 1 }
      }
    },
    "tool": {
      "type": "object",
      "x-proto-message": "Tool",
      "additionalProperties": false,
      "required": ["name", "description", "risk"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,128}$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "risk": { "type": "string", "x-proto-enum": "Risk", "enum": ["read", "write", "egress", "destructive"] },
        "mcp_server": { "description": "The listing id of the MCP server the tool comes from.", "type": "string" }
      }
    },
    "place_template": {
      "type": "object",
      "x-proto-message": "PlaceTemplate",
      "additionalProperties": false,
      "properties": {
        "data": { "type": "array", "items": { "$ref": "#/$defs/data_scope" } },
        "egress": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/host" } },
        "always_ask": {
          "description": "Tool names that ask the person every time, whatever the thread's mode.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "roles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" } }
      }
    },
    "data_scope": {
      "type": "object",
      "x-proto-message": "DataScope",
      "additionalProperties": false,
      "required": ["kind", "name", "access"],
      "properties": {
        "kind": { "type": "string", "x-proto-enum": "DataKind", "enum": ["database", "collection", "stream", "bucket"] },
        "name": { "type": "string", "minLength": 1 },
        "access": { "type": "string", "x-proto-enum": "Access", "enum": ["read", "write"] }
      }
    },
    "models": {
      "type": "object",
      "x-proto-message": "Models",
      "additionalProperties": false,
      "required": ["api"],
      "properties": {
        "requires": { "$ref": "#/$defs/model_requirements" },
        "suggested": { "$ref": "#/$defs/suggested_model" },
        "api": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "x-proto-enum": "ModelApi", "enum": ["chat-completions", "responses", "anthropic-messages"] }
        }
      }
    },
    "model_requirements": {
      "type": "object",
      "x-proto-message": "ModelRequirements",
      "additionalProperties": false,
      "properties": {
        "tools": { "type": "boolean" },
        "vision": { "type": "boolean" },
        "context_min": { "type": "integer", "minimum": 1 }
      }
    },
    "suggested_model": {
      "type": "object",
      "x-proto-message": "SuggestedModel",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      }
    },
    "cost_profile": {
      "type": "object",
      "x-proto-message": "CostProfile",
      "additionalProperties": false,
      "properties": {
        "typical_tokens_per_run": { "type": "integer", "minimum": 0 },
        "max_tokens_per_run": { "type": "integer", "minimum": 0 },
        "typical_runs_per_day": { "type": "integer", "minimum": 0 },
        "budget_usd_per_run": { "type": "number", "minimum": 0 },
        "budget_usd_per_day": { "type": "number", "minimum": 0 }
      }
    },
    "config_input": {
      "type": "object",
      "x-proto-message": "ConfigInput",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "type": { "type": "string", "x-proto-enum": "ConfigType", "enum": ["string", "number", "boolean", "enum"] },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "secret": {
          "description": "Stored in agentd's vault, never in the manifest or the index.",
          "type": "boolean"
        },
        "default": {},
        "values": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "env": {
          "description": "The environment variable the value is passed in.",
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "secret": { "const": true } }, "required": ["secret"] },
          "then": { "not": { "required": ["default"] } }
        },
        {
          "if": { "properties": { "type": { "const": "enum" } } },
          "then": { "required": ["values"] },
          "else": { "not": { "required": ["values"] } }
        }
      ]
    },
    "conformance": {
      "type": "object",
      "x-proto-message": "Conformance",
      "additionalProperties": false,
      "required": ["level", "report"],
      "properties": {
        "level": { "type": "string", "x-proto-enum": "ConformanceLevel", "enum": ["core", "compatible", "native"] },
        "report": { "$ref": "#/$defs/https_url" },
        "report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "harness": {
      "type": "object",
      "x-proto-message": "Harness",
      "additionalProperties": false,
      "required": ["launch", "auth"],
      "properties": {
        "launch": { "$ref": "#/$defs/harness_launch" },
        "auth": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "x-proto-enum": "AuthKind", "enum": ["none", "api-key", "oauth", "cli-login"] }
        },
        "models": { "description": "Model ids the harness offers.", "type": "array", "items": { "type": "string" } },
        "native_adapter": {
          "description": "agentd's built-in adapter, by its harness wire name (claude-code, codex, opencode, pi, ...).",
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "launch": { "properties": { "protocol": { "const": "native" } } } } },
          "then": { "required": ["native_adapter"] },
          "else": { "not": { "required": ["native_adapter"] } }
        }
      ]
    },
    "harness_launch": {
      "type": "object",
      "x-proto-message": "HarnessLaunch",
      "additionalProperties": false,
      "required": ["protocol"],
      "properties": {
        "protocol": { "type": "string", "x-proto-enum": "HarnessProtocol", "enum": ["acp", "native"] },
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } }
      }
    },
    "mcp_server": {
      "type": "object",
      "x-proto-message": "McpServer",
      "additionalProperties": false,
      "required": ["server", "mode"],
      "properties": {
        "server": {
          "description": "The official MCP Registry server.json, embedded unchanged (D1463).",
          "type": "object",
          "required": ["name", "description", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "mode": {
          "description": "local: agentd installs and starts the server from the listing's artifact. remote: agentd connects to remote_url and installs nothing.",
          "type": "string",
          "x-proto-enum": "McpServerMode",
          "enum": ["local", "remote"]
