      "repository": {
        "url": "https://github.com/github/github-mcp-server",
        "source": "github"
      },
      "version": "2.0.3",
      "packages": [
        {
          "registryType": "oci",
          "identifier": "ghcr.io/github/github-mcp-server:2.0.3",
          "transport": {
            "type": "stdio"
          }
        }
      ]
    },
    "mode": "local",
    "args": [
      "stdio"
    ],
    "transport": "stdio"
  },
  "pricing": "free"
