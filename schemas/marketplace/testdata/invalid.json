{
  "description": "Invalid listings, each a valid fixture with one rule broken. Applied by listing_schema_rejects_each_invalid_fixture (crates/loams-agentd-marketplace) and by loams-listing's lint tests. op is set (add or replace) or remove; paths are JSON Pointers.",
  "cases": [
    {
      "name": "missing-id",
      "rule": "Every listing has an id.",
      "base": "valid/agent-mastra-acp.json",
      "patch": [
        {
          "op": "remove",
          "path": "/id"
        }
      ]
    },
    {
      "name": "id-without-namespace",
      "rule": "An id is <namespace>/<name>.",
      "base": "valid/agent-mastra-acp.json",
      "patch": [
        {
          "op": "set",
          "path": "/id",
          "value": "loams-starter"
        }
      ]
    },
    {
      "name": "id-uppercase",
      "rule": "Ids are lower case.",
      "base": "valid/agent-mastra-acp.json",
      "patch": [
        {
          "op": "set",
          "path": "/id",
          "value": "Ostrium/Starter"
        }
      ]
    },
    {
      "name": "unknown-kind",
      "rule": "kind is agent, harness or mcp-server.",
      "base": "valid/agent-mastra-acp.json",
