# Versions for the Spark Connect parity harness (design 81 SP-b, D2009).
# SKELETON: these move into ../pins.env (with licences.toml entries, images by
# digest) in the task that first runs the harness; until then nothing here is
# pulled or installed by CI. Values are literal: no quotes, no variables.

# The PySpark Connect client whose parity tests run, and the Apache Spark
# source tag the tests are read from (python/pyspark/sql/tests/connect).
PYSPARK_CLIENT=4.0.1
SPARK_TAG=v4.0.1
# The Python the tests run on.
SPARK_TEST_PYTHON=3.12
