# The rw_catalog reads behind `loams risingwave list` and `progress`
# (crates/loams-risingwave/src/sql_api.rs) work on this RisingWave version.

query T
SELECT count(*) >= 0 FROM rw_catalog.rw_ddl_progress;
----
t

query T
SELECT count(*) >= 0 FROM rw_catalog.rw_materialized_views r JOIN rw_catalog.rw_schemas s ON s.id = r.schema_id;
----
t

query T
SELECT count(*) >= 0 FROM rw_catalog.rw_sources r JOIN rw_catalog.rw_schemas s ON s.id = r.schema_id WHERE r.connector IS NOT NULL OR r.connector IS NULL;
----
t

query T
SELECT count(*) >= 0 FROM rw_catalog.rw_sinks r JOIN rw_catalog.rw_schemas s ON s.id = r.schema_id WHERE r.connector IS NOT NULL OR r.connector IS NULL;
----
t
