statement ok
SELECT r.id::varchar, s.name::varchar, r.name::varchar, r.connector::varchar, r.definition::varchar FROM rw_catalog.rw_sinks r JOIN rw_catalog.rw_schemas s ON s.id = r.schema_id WHERE s.name NOT IN ('rw_catalog', 'pg_catalog', 'information_schema') ORDER BY s.name, r.name

statement ok
SELECT r.id::varchar, s.name::varchar, r.name::varchar, NULL::varchar, r.definition::varchar FROM rw_catalog.rw_tables r JOIN rw_catalog.rw_schemas s ON s.id = r.schema_id WHERE s.name NOT IN ('rw_catalog', 'pg_catalog', 'information_schema') ORDER BY s.name, r.name

statement ok
SELECT ddl_id::varchar, ddl_statement::varchar, progress::varchar, initialized_at::varchar FROM rw_catalog.rw_ddl_progress ORDER BY ddl_id

