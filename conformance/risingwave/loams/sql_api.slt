# The exact statements crates/loams-risingwave/src/sql_api.rs sends (simple
# query protocol, text casts), so a RisingWave upgrade that renames a catalog
# column fails here first.

statement ok
SELECT r.id::varchar, s.name::varchar, r.name::varchar, NULL::varchar, r.definition::varchar FROM rw_catalog.rw_materialized_views r JOIN rw_catalog.rw_schemas s ON s.id = r.schema_id WHERE s.name NOT IN ('rw_catalog', 'pg_catalog', 'information_schema') ORDER BY s.name, r.name

statement ok
