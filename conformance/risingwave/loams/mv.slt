# A materialized view as the builders render it (quoted identifiers, a watermark,
# a tumbling window), on a plain table so it needs no Kafka.

statement ok
CREATE TABLE "loams_conf_clicks" ("url" VARCHAR, "ts" TIMESTAMPTZ, WATERMARK FOR "ts" AS "ts" - INTERVAL '5 seconds') APPEND ONLY;

statement ok
CREATE MATERIALIZED VIEW IF NOT EXISTS "loams_conf_per_minute" AS
SELECT window_start, url, count(*) AS clicks
FROM TUMBLE(loams_conf_clicks, ts, INTERVAL '1 minute')
GROUP BY window_start, url;

statement ok
INSERT INTO "loams_conf_clicks" VALUES ('/a', '2026-10-27 10:00:01+00:00'), ('/a', '2026-10-27 10:00:30+00:00'), ('/b', '2026-10-27 10:00:59+00:00');

statement ok
FLUSH;

query TI rowsort
SELECT url, clicks FROM "loams_conf_per_minute";
----
/a 2
/b 1

statement ok
DROP MATERIALIZED VIEW "loams_conf_per_minute";

statement ok
DROP TABLE "loams_conf_clicks";
