# Pins for the RisingWave conformance harness (design 81, plan RW1, lane RW-b).
# Values are literal: no quotes, no variables, no spaces.

# The RisingWave release the managed profile runs. The upstream
# e2e files are read from the source tarball of the same tag.
RISINGWAVE_TAG=v3.1.0
# SHA-256 of https://codeload.github.com/risingwavelabs/risingwave/tar.gz/refs/tags/<tag>,
# recorded on the first run (2026-10-28). run.sh refuses a tarball that does not match.
RISINGWAVE_SRC_SHA256=49837481aad1dad2a6fc6ceaea2bcd188f2e5d7dee3e249662ca7841093dfb2a
# sqllogictest-rs's runner (crate sqllogictest-bin, Apache-2.0 OR MIT), installed
# into the harness's own tools directory with `cargo install --locked --root`.
SQLLOGICTEST_BIN=0.29.1
