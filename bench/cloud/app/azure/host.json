{
  "version": "2.0",
  "extensions": {
    "http": { "routePrefix": "" },
    "queues": { "batchSize": 8, "maxDequeueCount": 4, "messageEncoding": "base64" }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": { "isEnabled": true, "excludedTypes": "Request" }
    }
  }
}
