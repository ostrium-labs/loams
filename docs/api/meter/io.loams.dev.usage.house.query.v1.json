{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loams:json:io.loams.dev.usage.house.query.v1",
  "title": "io.loams.dev.usage.house.query.v1",
  "description": "The `data` of a `io.loams.dev.usage.house.query.v1` usage event: A House query, per worker lease. Producer: UsageObserver (House front). Design §63 §6.3. Measured values are integers in the unit named; dimensions are strings. New optional fields may be added within v1.",
  "type": "object",
  "properties": {
    "namespace": {
      "type": "string",
      "description": "The namespace the usage belongs to (its id)"
    },
    "cpu_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Worker CPU time, ms"
    },
    "bytes_scanned": {
      "type": "integer",
      "minimum": 0,
      "description": "Bytes read from storage"
    },
    "rows_read": {
      "type": "integer",
      "minimum": 0,
      "description": "Rows read"
    },
    "result_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Bytes of the result"
    },
    "worker_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Worker wall time, ms"
    },
    "statements": {
      "type": "integer",
      "minimum": 0,
      "description": "Statements run"
    },
    "code": {
      "type": "integer",
      "description": "The ClickHouse error code; 0 on success"
    }
  },
  "required": [
    "cpu_ms",
    "bytes_scanned",
    "rows_read",
    "result_bytes",
    "worker_ms",
    "statements",
    "code"
  ],
  "additionalProperties": true
}
